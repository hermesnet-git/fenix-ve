        <di:waypoint x="770" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Situacao_Indisponivel" bpmnElement="Flow_Situacao_Indisponivel">
        <di:waypoint x="670" y="535" />
        <di:waypoint x="670" y="870" />
        <di:waypoint x="2605" y="870" />
        <di:waypoint x="2605" y="750" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Andamento_Acao" bpmnElement="Flow_Andamento_Acao">
        <di:waypoint x="910" y="350" />
        <di:waypoint x="1030" y="350" />
        <di:waypoint x="1030" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Caminho_Acao" bpmnElement="Flow_Caminho_Acao">
        <di:waypoint x="910" y="470" />
        <di:waypoint x="1030" y="470" />
        <di:waypoint x="1030" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Concluida_Fim" bpmnElement="Flow_Concluida_Fim">
