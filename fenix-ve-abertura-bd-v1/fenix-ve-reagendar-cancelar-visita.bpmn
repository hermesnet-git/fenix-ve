<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://tlf.com.br/eljy/visita-local" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <process id="fenix-ve-reagendar-cancelar-visita" name="Fenix VE - visita tecnica (prototipo local)" isExecutable="true" camunda:versionTag="v1" camunda:historyTimeToLive="P1D">
    <documentation>Prototipo de teste com situacao sintetica; nao consulta nem altera visita real.</documentation>
    <startEvent id="Node_Start" />
    <sequenceFlow id="Flow_Start_Situacao" sourceRef="Node_Start" targetRef="Node_ConsultaBD" />
    <sequenceFlow id="Flow_ConsultaBD_Situacao" sourceRef="Node_ConsultaBD" targetRef="Node_Situacao" />
    <exclusiveGateway id="Node_Situacao" name="Situacao da visita" default="Flow_Situacao_Indisponivel" />
    <sequenceFlow id="Flow_Situacao_Andamento" sourceRef="Node_Situacao" targetRef="Node_Andamento">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('data_situacao') == 'andamento'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Situacao_Caminho" sourceRef="Node_Situacao" targetRef="Node_Caminho">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('data_situacao') == 'caminho'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Situacao_Concluida" sourceRef="Node_Situacao" targetRef="Node_Concluida">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('data_situacao') == 'concluida'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Situacao_Cancelada" sourceRef="Node_Situacao" targetRef="Node_Cancelada">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('data_situacao') == 'cancelada'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Situacao_Indisponivel" sourceRef="Node_Situacao" targetRef="Node_Indisponivel" />
    <userTask id="Node_Andamento" name="Visita em andamento" camunda:assignee="${assignee}" />
    <userTask id="Node_Caminho" name="Equipe a caminho" camunda:assignee="${assignee}" />
    <userTask id="Node_Concluida" name="Visita concluida" camunda:assignee="${assignee}" />
    <userTask id="Node_Cancelada" name="Visita cancelada" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_Andamento_Acao" sourceRef="Node_Andamento" targetRef="Node_Acao" />
    <sequenceFlow id="Flow_Caminho_Acao" sourceRef="Node_Caminho" targetRef="Node_Acao" />
    <sequenceFlow id="Flow_Concluida_Fim" sourceRef="Node_Concluida" targetRef="Node_End" />
    <sequenceFlow id="Flow_Cancelada_Fim" sourceRef="Node_Cancelada" targetRef="Node_End" />
    <exclusiveGateway id="Node_Acao" name="Acao escolhida" default="Flow_Acao_Indisponivel" />
    <sequenceFlow id="Flow_Acao_Escolha" sourceRef="Node_Acao" targetRef="Node_BloqueioSlots">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('form_acaoVisita') == 'reagendar'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Acao_Cancelamento" sourceRef="Node_Acao" targetRef="Node_ConfirmarCancelamento">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('form_acaoVisita') == 'cancelar'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Acao_Indisponivel" sourceRef="Node_Acao" targetRef="Node_Indisponivel" />
    <exclusiveGateway id="Node_BloqueioSlots" name="Consulta de horarios pendente" default="Flow_BloqueioSlots_Escolha" />
    <sequenceFlow id="Flow_BloqueioSlots_Escolha" sourceRef="Node_BloqueioSlots" targetRef="Node_Escolha" />
    <sequenceFlow id="Flow_Bloqueio_ConsultaSlots" sourceRef="Node_BloqueioSlots" targetRef="Node_ConsultaSlots">
      <conditionExpression xsi:type="tFormalExpression">${false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ConsultaSlots_Escolha" sourceRef="Node_ConsultaSlots" targetRef="Node_Escolha" />
    <userTask id="Node_Escolha" name="Escolher data e periodo" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_Escolha_Confirmacao" sourceRef="Node_Escolha" targetRef="Node_ConfirmarReagendamento" />
    <userTask id="Node_ConfirmarReagendamento" name="Confirmar reagendamento" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_Confirmacao_Decisao" sourceRef="Node_ConfirmarReagendamento" targetRef="Node_DecReagendamento" />
    <exclusiveGateway id="Node_DecReagendamento" name="Confirmar reagendamento" default="Flow_Reagendamento_Indisponivel" />
    <sequenceFlow id="Flow_Reagendamento_Alterar" sourceRef="Node_DecReagendamento" targetRef="Node_Escolha">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('form_confirmacaoReagendar') == 'alterar'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Reagendamento_Indisponivel" sourceRef="Node_DecReagendamento" targetRef="Node_BloqueioReagendamento" />
    <exclusiveGateway id="Node_BloqueioReagendamento" name="Reagendamento pendente" default="Flow_BloqueioReagendamento_Indisponivel" />
    <sequenceFlow id="Flow_BloqueioReagendamento_Indisponivel" sourceRef="Node_BloqueioReagendamento" targetRef="Node_Indisponivel" />
    <sequenceFlow id="Flow_Bloqueio_ReagendaWFM" sourceRef="Node_BloqueioReagendamento" targetRef="Node_ReagendaWFM">
      <conditionExpression xsi:type="tFormalExpression">${false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ReagendaWFM_AtualizaBD" sourceRef="Node_ReagendaWFM" targetRef="Node_AtualizaBDReagendado" />
    <sequenceFlow id="Flow_AtualizaBDReagendado_Indisponivel" sourceRef="Node_AtualizaBDReagendado" targetRef="Node_DecSucessoReagendamento" />
    <exclusiveGateway id="Node_DecSucessoReagendamento" name="Sucesso pendente de validacao" default="Flow_Reagendamento_SemConfirmacao" />
    <sequenceFlow id="Flow_Reagendamento_SemConfirmacao" sourceRef="Node_DecSucessoReagendamento" targetRef="Node_Indisponivel" />
    <sequenceFlow id="Flow_Sucesso_Reagendada" sourceRef="Node_DecSucessoReagendamento" targetRef="Node_Reagendada">
      <conditionExpression xsi:type="tFormalExpression">${false}</conditionExpression>
    </sequenceFlow>
    <userTask id="Node_Reagendada" name="Visita reagendada" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_Reagendada_End" sourceRef="Node_Reagendada" targetRef="Node_End" />
    <userTask id="Node_ConfirmarCancelamento" name="Confirmar intencao de cancelar" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_Cancelamento_Decisao" sourceRef="Node_ConfirmarCancelamento" targetRef="Node_DecCancelamento" />
    <exclusiveGateway id="Node_DecCancelamento" name="Cancelar ou reagendar" default="Flow_Cancelamento_Indisponivel" />
    <sequenceFlow id="Flow_Cancelamento_Reagendar" sourceRef="Node_DecCancelamento" targetRef="Node_BloqueioSlots">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('form_acaoCancelamento') == 'reagendar'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Cancelamento_Motivo" sourceRef="Node_DecCancelamento" targetRef="Node_Motivo">
      <conditionExpression xsi:type="tFormalExpression">${execution.getVariable('form_acaoCancelamento') == 'cancelar'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Cancelamento_Indisponivel" sourceRef="Node_DecCancelamento" targetRef="Node_Indisponivel" />
    <userTask id="Node_Motivo" name="Motivo do cancelamento" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_Motivo_Indisponivel" sourceRef="Node_Motivo" targetRef="Node_BloqueioCancelamento" />
    <exclusiveGateway id="Node_BloqueioCancelamento" name="Cancelamento pendente" default="Flow_BloqueioCancelamento_Indisponivel" />
    <sequenceFlow id="Flow_BloqueioCancelamento_Indisponivel" sourceRef="Node_BloqueioCancelamento" targetRef="Node_Indisponivel" />
    <sequenceFlow id="Flow_Bloqueio_CancelaWFM" sourceRef="Node_BloqueioCancelamento" targetRef="Node_CancelaWFM">
      <conditionExpression xsi:type="tFormalExpression">${false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CancelaWFM_AtualizaBD" sourceRef="Node_CancelaWFM" targetRef="Node_AtualizaBDCancelado" />
    <sequenceFlow id="Flow_AtualizaBDCancelado_Indisponivel" sourceRef="Node_AtualizaBDCancelado" targetRef="Node_DecSucessoCancelamento" />
    <exclusiveGateway id="Node_DecSucessoCancelamento" name="Sucesso pendente de validacao" default="Flow_Cancelamento_SemConfirmacao" />
    <sequenceFlow id="Flow_Cancelamento_SemConfirmacao" sourceRef="Node_DecSucessoCancelamento" targetRef="Node_Indisponivel" />
    <sequenceFlow id="Flow_Sucesso_Cancelamento" sourceRef="Node_DecSucessoCancelamento" targetRef="Node_CancelamentoConcluido">
      <conditionExpression xsi:type="tFormalExpression">${false}</conditionExpression>
    </sequenceFlow>
    <userTask id="Node_CancelamentoConcluido" name="Cancelamento concluido" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_CancelamentoConcluido_End" sourceRef="Node_CancelamentoConcluido" targetRef="Node_End" />
    <userTask id="Node_Indisponivel" name="Operacao indisponivel no prototipo" camunda:assignee="${assignee}" />
    <sequenceFlow id="Flow_Indisponivel_Fim" sourceRef="Node_Indisponivel" targetRef="Node_End" />
    <endEvent id="Node_End" name="Fim do prototipo" />
    <serviceTask id="Node_ConsultaBD" name="Consultar BD - pendente" camunda:delegateExpression="${httpTask}">
      <documentation>Pendente: filtro pelo numero do BD, identificacao unica, autorizacao, headers e resposta.</documentation>
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_TT_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">/troubleTicket</camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_Start_Situacao</incoming>
    </serviceTask>
    <serviceTask id="Node_ConsultaSlots" name="Consultar horarios - pendente" camunda:delegateExpression="${httpTask}">
      <documentation>Pendente: payload e dados de rede, headers, autorizacao, tratamento de 204 e validacao dos horarios.</documentation>
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_WFM_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">/searchTimeSlot</camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <serviceTask id="Node_AtualizaBDReagendado" name="Atualizar BD reagendado - pendente" camunda:delegateExpression="${httpTask}">
      <documentation>Pendente: ID interno do ticket, path codificado, payload, headers e regra de atualizacao apos WFM.</documentation>
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">PATCH</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_TT_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <serviceTask id="Node_AtualizaBDCancelado" name="Atualizar BD cancelado - pendente" camunda:delegateExpression="${httpTask}">
      <documentation>Pendente: ID interno do ticket, path codificado, motivo, payload, headers e regra de cancelamento do BD.</documentation>
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">PATCH</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_TT_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <serviceTask id="Node_ReagendaWFM" name="Reagendar visita WFM - contrato pendente" camunda:delegateExpression="${httpTask}">
      <documentation>Pendente: metodo, base, path, headers, payload, identificador do agendamento, autorizacao, idempotencia e consulta de resultado.</documentation>
    </serviceTask>
    <serviceTask id="Node_CancelaWFM" name="Cancelar visita WFM - contrato pendente" camunda:delegateExpression="${httpTask}">
      <documentation>Pendente: metodo, base, path, headers, payload, identificador da visita, motivo, autorizacao, idempotencia e consulta de resultado.</documentation>
    </serviceTask>
  </process>
