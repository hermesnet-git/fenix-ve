    <bpmn:serviceTask id="Node_CancelaWO" name="Cancela WO (INT16)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>US-10: BD não criado (recusa ou 3ª falha) cancela a WO. INT16 DELETE /workOrder/{idWorkOrder}?reason=PROBLEMAS SISTEMICOS&amp;context=SISTEMICO (PreDataMapping Cancelamento de WO v1.1; sobrescrevíveis por wo_cancelReason/wo_cancelContext). 200 com body vazio.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">DELETE</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_WFM_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">
            <camunda:script scriptFormat="groovy">'/workOrder/' + java.net.URLEncoder.encode(execution.getVariable('data_woNumero').toString(), 'UTF-8') + '?reason=' + java.net.URLEncoder.encode((execution.getVariable('data_wo_cancelReason') ?: 'PROBLEMAS SISTEMICOS').toString(), 'UTF-8') + '&amp;context=' + java.net.URLEncoder.encode((execution.getVariable('data_wo_cancelContext') ?: 'SISTEMICO').toString(), 'UTF-8')</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
h['Content-Type'] = 'application/json'
h['flow'] = 'B2B_MASSIVO'
h['requestSystem'] = 'MVE'
h['X-Vivo-Transaction-Id'] = 'TID_ELJY_FTAT933INT008_' + java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())
def cid = execution.getVariable('data_correlationId')
if (cid) { h['X-Vivo-Correlation-Id'] = cid.toString() }
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecWOIdentificadaBD_CancelaWO</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelaWO_BDNaoCriado</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_BDNaoCriado" name="BD não criado" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecWOIdentificadaBD_BDNaoCriado</bpmn:incoming>
      <bpmn:incoming>Flow_CancelaWO_BDNaoCriado</bpmn:incoming>
      <bpmn:outgoing>Flow_BDNaoCriado_End_BDNaoCriado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_End_BDNaoCriado" name="Fim — BD não criado">
      <bpmn:incoming>Flow_BDNaoCriado_End_BDNaoCriado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_VisitaAgendada" name="Você agendou a visita técnica" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecBDCriado_VisitaAgendada</bpmn:incoming>
      <bpmn:outgoing>Flow_VisitaAgendada_End_Agendado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_End_Agendado" name="Fim — visita agendada e BD criado">
      <bpmn:incoming>Flow_VisitaAgendada_End_Agendado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_FalhaConsulta" name="Não conseguimos verificar" camunda:assignee="${assignee}">
      <bpmn:documentation>US-01/02 Obs. 2: falha de integração orienta outro atendimento ou nova tentativa mais tarde.</bpmn:documentation>
      <bpmn:incoming>Flow_DecMassivaOk_FalhaConsulta</bpmn:incoming>
