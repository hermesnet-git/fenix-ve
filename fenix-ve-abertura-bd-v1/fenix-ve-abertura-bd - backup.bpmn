<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_fenix_ve_abertura_bd" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="fenix-ve-abertura-bd" name="Fenix - Abertura de BD" isExecutable="true" camunda:versionTag="v1" camunda:historyTimeToLive="P180D">
    <bpmn:documentation>FTAT-933 Abertura de BD pelo VE (APP). O ms-journey-v1 acha a jornada a33acd94-31d3-401e-b8cd-f50506e45667 desta chave em espec_registry.process_key para resolver as telas SDUI. Gerado por Fenix-VE/skills/gerar_fenix_ve_abertura_bd.py.</bpmn:documentation>
    <bpmn:startEvent id="Node_Start" name="Início">
      <bpmn:documentation>Entradas (START, via ms-journey-v1): designador, productStatus, correlationId, requestTimestamp, issServiceNow (data_* no motor). Opcionais: hpsdRelatedServiceId, hpsdTestSpecificationId, wfm*, wo_&lt;campo&gt;, bd_&lt;campo&gt;. Vindos da consulta de asset do VE: wo_customerId, wo_customerName, wo_documentNumber, wo_productId, wo_acessoId, wo_acessoDesignador, wfmPostcode, wfmCnl, wo_cnlAcronym, wfmNetworkOwner, wfmTelephonicArea, wfmCentralOffice, wfmMicroArea, wfmMediaType, wfmGeographicSiteId, wo_city, wo_neighborhood, wo_stateOrProvince, wo_streetCode, wo_streetName, wo_streetNr, wo_complement.</bpmn:documentation>
      <bpmn:outgoing>Flow_Start_Inicio</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Node_Inicio" name="Vamos verificar seu serviço" camunda:assignee="${assignee}">
      <bpmn:documentation>Figma "Validação de status". Também garante o Bearer do usuário (/advance) antes das consultas.</bpmn:documentation>
      <bpmn:incoming>Flow_Start_Inicio</bpmn:incoming>
      <bpmn:outgoing>Flow_Inicio_ConsultaMassiva</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_ConsultaMassiva" name="Consulta Massiva/Manutenção (INT01)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>INT01 Customer Problem Management v1: GET /incidents?serviceDesignator. Incidente com status != CLOSED = massiva aberta. Pendente: campo oficial de protocolo (usado incidentId).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_CPM_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">
            <camunda:script scriptFormat="groovy">'/incidents?serviceDesignator=' + java.net.URLEncoder.encode((execution.getVariable('data_designador') ?: '').toString(), 'UTF-8')</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
def cid = execution.getVariable('data_correlationId')
if (cid) { h['X-Vivo-Correlation-Id'] = cid.toString() }
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Inicio_ConsultaMassiva</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsultaMassiva_TrataMassiva</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Node_TrataMassiva" name="Interpreta Massiva" scriptFormat="groovy">
      <bpmn:incoming>Flow_ConsultaMassiva_TrataMassiva</bpmn:incoming>
      <bpmn:outgoing>Flow_TrataMassiva_DecMassivaOk</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def formatarData(Object valor) {
    if (valor == null || valor.toString().trim().isEmpty()) { return null }
    def texto = valor.toString().trim()
    def fmt = DateTimeFormatter.ofPattern("dd/MM 'às' HH'h'mm")
    try { return OffsetDateTime.parse(texto).atZoneSameInstant(ZoneId.of('America/Sao_Paulo')).format(fmt) } catch (Exception ignored) { }
    try { return LocalDateTime.parse(texto).format(fmt) } catch (Exception ignored) { }
    return texto
}

def status = execution.getVariable('Node_ConsultaMassiva-status')
def ok = false
def abertas = []
if (status == 200) {
    ok = true
    def json = lerJson(execution.getVariable('Node_ConsultaMassiva-response'))
    def incidentes = (json instanceof Map &amp;&amp; json.incidents instanceof List) ? json.incidents : []
    abertas = incidentes.findAll { it instanceof Map &amp;&amp; !'CLOSED'.equalsIgnoreCase(String.valueOf(it.status)) }
} else if (status == 404) {
    ok = true
}
def massiva = abertas ? abertas[0] : null
execution.setVariable('data_consultaMassivaOk', ok)
execution.setVariable('data_temMassiva', massiva != null)
execution.setVariable('data_massivaProtocolo', massiva?.incidentId?.toString())
execution.setVariable('data_massivaPrevisaoConclusao', formatarData(massiva?.expectedResolutionDate))
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecMassivaOk" name="Consulta de Massiva respondeu?" default="Flow_DecMassivaOk_FalhaConsulta">
      <bpmn:incoming>Flow_TrataMassiva_DecMassivaOk</bpmn:incoming>
      <bpmn:outgoing>Flow_DecMassivaOk_ConsultaBD</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecMassivaOk_FalhaConsulta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Node_ConsultaBD" name="Consulta BD aberto (INT03)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>INT03 ServiceNow Trouble Ticket v1: GET /troubleTicket?designatorId=..&amp;status=Active&amp;ticketType=Case&amp;offset=0&amp;limit=5&amp;sys_class_name=sn_sprb_mgmt_case. 404 = nenhum BD ativo.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_TT_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">
            <camunda:script scriptFormat="groovy">'/troubleTicket?designatorId=' + java.net.URLEncoder.encode((execution.getVariable('data_designador') ?: '').toString(), 'UTF-8') + '&amp;status=Active&amp;ticketType=Case&amp;offset=0&amp;limit=5&amp;sys_class_name=sn_sprb_mgmt_case'</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
def issServiceNow = execution.getVariable('data_issServiceNow')
if (issServiceNow == null || issServiceNow.toString().trim().isEmpty()) { throw new IllegalArgumentException('issServiceNow deve ser informado para execução da task Consulta BD aberto (INT03)') }
h['iss'] = issServiceNow.toString()
h['X-Vivo-Transaction-Id'] = 'TID_ELJY_FTAT933INT003_' + java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())
def cid = execution.getVariable('data_correlationId')
if (cid) { h['X-Vivo-Correlation-Id'] = cid.toString() }
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecMassivaOk_ConsultaBD</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsultaBD_TrataBD</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Node_TrataBD" name="Interpreta BD" scriptFormat="groovy">
      <bpmn:incoming>Flow_ConsultaBD_TrataBD</bpmn:incoming>
      <bpmn:outgoing>Flow_TrataBD_DecBDOk</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def caracteristica(Object ticket, String nome) {
    def lista = (ticket instanceof Map &amp;&amp; ticket.relatedEntity instanceof List) ? ticket.relatedEntity : []
    for (item in lista) {
        if (!(item instanceof Map)) { continue }
        def alvo = item.entity instanceof Map ? item.entity : item
        if (nome.equalsIgnoreCase(String.valueOf(alvo.name))) { return alvo.id?.toString() }
    }
    return null
}

def status = execution.getVariable('Node_ConsultaBD-status')
def ok = false
def ticket = null
if (status == 200) {
    ok = true
    def json = lerJson(execution.getVariable('Node_ConsultaBD-response'))
    def lista = json instanceof List ? json : []
    ticket = lista.find { it instanceof Map &amp;&amp; !(String.valueOf(it.status).toLowerCase() in ['closed', 'cancelled', 'canceled', 'resolved']) }
} else if (status == 404) {
    ok = true
}
execution.setVariable('data_consultaBDOk', ok)
execution.setVariable('data_temBD', ticket != null)
execution.setVariable('data_bdNumero', ticket?.id?.toString())
execution.setVariable('data_bdProtocoloAtendimento', caracteristica(ticket, 'number') ?: ticket?.externalIdentifier?.id?.toString())
execution.setVariable('data_bdPrevisaoConclusao', caracteristica(ticket, 'ets'))
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecBDOk" name="Consulta de BD respondeu?" default="Flow_DecBDOk_FalhaConsulta">
      <bpmn:incoming>Flow_TrataBD_DecBDOk</bpmn:incoming>
      <bpmn:outgoing>Flow_DecBDOk_AvaliaImpedimentos</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecBDOk_FalhaConsulta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Node_AvaliaImpedimentos" name="Avalia impedimentos" scriptFormat="groovy">
      <bpmn:documentation>US-03: Massiva+fatura, Massiva+BD, Massiva, fatura, BD. Combinações não especificadas (BD+fatura sem Massiva; as três) seguem a precedência fatura &gt; BD.</bpmn:documentation>
      <bpmn:incoming>Flow_DecBDOk_AvaliaImpedimentos</bpmn:incoming>
      <bpmn:outgoing>Flow_AvaliaImpedimentos_DecImpedimento</bpmn:outgoing>
      <bpmn:script>def massiva = execution.getVariable('data_temMassiva') == true
def bd = execution.getVariable('data_temBD') == true
def fatura = 'bloqueio'.equalsIgnoreCase(String.valueOf(execution.getVariable('data_productStatus') ?: '').trim())
def impedimento = 'NENHUM'
if (massiva &amp;&amp; fatura) {
    impedimento = 'MASSIVA_ATRASO'
} else if (massiva &amp;&amp; bd) {
    impedimento = 'MASSIVA_VISITA'
} else if (massiva) {
    impedimento = 'MASSIVA'
} else if (fatura) {
    impedimento = 'ATRASO'
} else if (bd) {
    impedimento = 'VISITA'
}
execution.setVariable('data_bloqueioFinanceiro', fatura)
execution.setVariable('data_impedimento', impedimento)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecImpedimento" name="Cliente tem impedimento?" default="Flow_DecImpedimento_Reinicie">
      <bpmn:incoming>Flow_AvaliaImpedimentos_DecImpedimento</bpmn:incoming>
      <bpmn:outgoing>Flow_DecImpedimento_StatusMassivaAtraso</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecImpedimento_StatusMassivaVisita</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecImpedimento_StatusMassiva</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecImpedimento_StatusAtraso</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecImpedimento_StatusVisita</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecImpedimento_Reinicie</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_StatusMassivaAtraso" name="Massiva + atraso em pagamentos" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecImpedimento_StatusMassivaAtraso</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusMassivaAtraso_End_Impedimento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_StatusMassivaVisita" name="Massiva + visita técnica" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecImpedimento_StatusMassivaVisita</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusMassivaVisita_End_Impedimento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_StatusMassiva" name="Massiva" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecImpedimento_StatusMassiva</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusMassiva_End_Impedimento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_StatusAtraso" name="Atraso em pagamentos" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecImpedimento_StatusAtraso</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusAtraso_End_Impedimento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_StatusVisita" name="Visita técnica agendada" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecImpedimento_StatusVisita</bpmn:incoming>
      <bpmn:outgoing>Flow_StatusVisita_End_Impedimento</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_End_Impedimento" name="Fim — impedimento">
      <bpmn:incoming>Flow_StatusMassivaAtraso_End_Impedimento</bpmn:incoming>
      <bpmn:incoming>Flow_StatusMassivaVisita_End_Impedimento</bpmn:incoming>
      <bpmn:incoming>Flow_StatusMassiva_End_Impedimento</bpmn:incoming>
      <bpmn:incoming>Flow_StatusAtraso_End_Impedimento</bpmn:incoming>
      <bpmn:incoming>Flow_StatusVisita_End_Impedimento</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_Reinicie" name="Reinicie o modem" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecImpedimento_Reinicie</bpmn:incoming>
      <bpmn:outgoing>Flow_Reinicie_DecReinicio</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_DecReinicio" name="Conseguiu reiniciar?" default="Flow_DecReinicio_VoltouReinicio">
      <bpmn:incoming>Flow_Reinicie_DecReinicio</bpmn:incoming>
      <bpmn:outgoing>Flow_DecReinicio_TesteConexao</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecReinicio_VoltouReinicio</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_VoltouReinicio" name="A internet voltou?" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecReinicio_VoltouReinicio</bpmn:incoming>
      <bpmn:outgoing>Flow_VoltouReinicio_DecVoltouReinicio</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_DecVoltouReinicio" name="Voltou após reiniciar?" default="Flow_DecVoltouReinicio_TesteConexao">
      <bpmn:incoming>Flow_VoltouReinicio_DecVoltouReinicio</bpmn:incoming>
      <bpmn:outgoing>Flow_DecVoltouReinicio_InternetVoltou</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecVoltouReinicio_TesteConexao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_InternetVoltou" name="Sua internet voltou" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecVoltouReinicio_InternetVoltou</bpmn:incoming>
      <bpmn:incoming>Flow_DecVoltouNovamente_InternetVoltou</bpmn:incoming>
      <bpmn:incoming>Flow_DecVoltouEnergia_InternetVoltou</bpmn:incoming>
      <bpmn:outgoing>Flow_InternetVoltou_End_Resolvido</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_End_Resolvido" name="Fim — problema resolvido">
      <bpmn:incoming>Flow_InternetVoltou_End_Resolvido</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_TesteConexao" name="Vamos testar a sua conexão" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecReinicio_TesteConexao</bpmn:incoming>
      <bpmn:incoming>Flow_DecVoltouReinicio_TesteConexao</bpmn:incoming>
      <bpmn:outgoing>Flow_TesteConexao_DecTeste</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_DecTeste" name="Cliente quer testar?" default="Flow_DecTeste_SolicitaDiagnostico">
      <bpmn:incoming>Flow_TesteConexao_DecTeste</bpmn:incoming>
      <bpmn:outgoing>Flow_DecTeste_End_Desistiu</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecTeste_SolicitaDiagnostico</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Node_End_Desistiu" name="Fim — cliente voltou ao início">
      <bpmn:incoming>Flow_DecTeste_End_Desistiu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_SolicitaDiagnostico" name="Solicita diagnóstico HPSD (INT06)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>INT06 TMF653 POST /serviceTest. relatedParty ExternalId = processInstanceId (correlação do retorno Kafka). Pendente: testSpecification.id/relatedService.id (P06).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_HPSD_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">/serviceTest</camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
h['Content-Type'] = 'application/json'
h['X-Vivo-Transaction-Id'] = UUID.randomUUID().toString()
h['X-Vivo-Correlation-Id'] = UUID.randomUUID().toString()
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="bodyTemplate">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def designador = execution.getVariable('data_designador')?.toString()
def servico = execution.getVariable('data_hpsdRelatedServiceId') ?: designador
def body = [
    name: 'Diagnóstico automático FTTH',
    relatedService: [id: servico?.toString()],
    testSpecification: [id: execution.getVariable('data_hpsdTestSpecificationId')?.toString()],
    relatedParty: [[id: execution.getProcessInstanceId(), role: 'ExternalId']]
]
JsonOutput.toJson(body)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">15000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecTeste_SolicitaDiagnostico</bpmn:incoming>
      <bpmn:outgoing>Flow_SolicitaDiagnostico_TrataSolicitacaoDiagnostico</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Node_TrataSolicitacaoDiagnostico" name="Interpreta aceite do diagnóstico" scriptFormat="groovy">
      <bpmn:incoming>Flow_SolicitaDiagnostico_TrataSolicitacaoDiagnostico</bpmn:incoming>
      <bpmn:outgoing>Flow_TrataSolicitacaoDiagnostico_DecDiagnosticoAceito</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def status = execution.getVariable('Node_SolicitaDiagnostico-status')
def json = lerJson(execution.getVariable('Node_SolicitaDiagnostico-response'))
def ok = status in [200, 201, 202]
execution.setVariable('data_diagnosticoSolicitado', ok)
execution.setVariable('data_diagnosticoServiceTestId', (ok &amp;&amp; json instanceof Map) ? json.id?.toString() : null)
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecDiagnosticoAceito" name="Diagnóstico aceito?" default="Flow_DecDiagnosticoAceito_FalhaConsulta">
      <bpmn:incoming>Flow_TrataSolicitacaoDiagnostico_DecDiagnosticoAceito</bpmn:incoming>
      <bpmn:outgoing>Flow_DecDiagnosticoAceito_AguardaDiagnostico</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecDiagnosticoAceito_FalhaConsulta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Node_AguardaDiagnostico" name="Aguarda resultado do diagnóstico">
      <bpmn:incoming>Flow_DecDiagnosticoAceito_AguardaDiagnostico</bpmn:incoming>
      <bpmn:outgoing>Flow_AguardaDiagnostico_RetornoDiagnostico</bpmn:outgoing>
      <bpmn:outgoing>Flow_AguardaDiagnostico_TimeoutDiagnostico</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Node_RetornoDiagnostico" name="Retorno do diagnóstico (INT10)">
      <bpmn:documentation>INT10 Kafka. O ms-journey-event-consumer-v1 entrega o evento ao motor, que localiza a instância pelo JSONPath de inbound_correlation_config e dispara esta espera pelo correlationTopic. O payload não vira variável.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="correlationTopic" value="telco.service.servicetestmanagement.servicetestresult" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AguardaDiagnostico_RetornoDiagnostico</bpmn:incoming>
      <bpmn:outgoing>Flow_RetornoDiagnostico_ConsultaResultadoDiagnostico</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Node_RetornoDiagnostico_Def" messageRef="Message_RetornoDiagnosticoHPSD" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Node_TimeoutDiagnostico" name="Sem resposta do diagnóstico">
      <bpmn:documentation>Figma: "ID 01, 02, 08 ou sem resposta" segue para a abertura de BD.</bpmn:documentation>
      <bpmn:incoming>Flow_AguardaDiagnostico_TimeoutDiagnostico</bpmn:incoming>
      <bpmn:outgoing>Flow_TimeoutDiagnostico_AgendarVisita</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Node_TimeoutDiagnostico_Def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${environment.getProperty('FENIX_VE_HPSD_TIMEOUT', 'PT3M')}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Node_ConsultaResultadoDiagnostico" name="Consulta resultado do diagnóstico (TMF653)" camunda:asyncBefore="true" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>GET /serviceTest/{id}: o evento Kafka só retoma a instância; o resultado (RESULTADO_DIAGNOSTICO) é lido aqui. Executa em segundo plano (asyncBefore): não há Bearer do usuário nesta transação.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT10S</camunda:failedJobRetryTimeCycle>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_HPSD_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">
            <camunda:script scriptFormat="groovy">'/serviceTest/' + java.net.URLEncoder.encode((execution.getVariable('data_diagnosticoServiceTestId') ?: 'sem-id').toString(), 'UTF-8')</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
h['X-Vivo-Transaction-Id'] = UUID.randomUUID().toString()
h['X-Vivo-Correlation-Id'] = UUID.randomUUID().toString()
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RetornoDiagnostico_ConsultaResultadoDiagnostico</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsultaResultadoDiagnostico_TrataResultadoDiagnostico</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Node_TrataResultadoDiagnostico" name="Interpreta resultado do diagnóstico" scriptFormat="groovy">
      <bpmn:documentation>ID06/07/10 = resolvido; ID09 = sem energia; outros ou sem resultado = problema persiste.</bpmn:documentation>
      <bpmn:incoming>Flow_ConsultaResultadoDiagnostico_TrataResultadoDiagnostico</bpmn:incoming>
      <bpmn:outgoing>Flow_TrataResultadoDiagnostico_DecResultadoDiagnostico</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def extrairId(Object valor) {
    if (valor == null) { return null }
    def m = (valor.toString() =~ /(?i)\bID\s*[:\-]?\s*0*(\d{1,2})\b/)
    return m.find() ? String.format('%02d', Integer.parseInt(m.group(1))) : null
}

def status = execution.getVariable('Node_ConsultaResultadoDiagnostico-status')
def json = lerJson(execution.getVariable('Node_ConsultaResultadoDiagnostico-response'))
def id = null
if (status == 200 &amp;&amp; json instanceof Map) {
    def caracteristicas = json.characteristic instanceof List ? json.characteristic : []
    id = extrairId(caracteristicas.find { it instanceof Map &amp;&amp; 'RESULTADO_DIAGNOSTICO'.equalsIgnoreCase(String.valueOf(it.name)) }?.value)
    if (!id &amp;&amp; json.testMeasure instanceof List) {
        for (medida in json.testMeasure) {
            def valor = (medida instanceof Map &amp;&amp; medida.value instanceof Map) ? medida.value.value : null
            if (valor instanceof Map) {
                id = extrairId(valor.resultado_diagnostico)
                if (id) { break }
            }
        }
    }
}
def resultado = id in ['06', '07', '10'] ? 'RESOLVIDO' : (id == '09' ? 'SEM_ENERGIA' : 'PERSISTE')
execution.setVariable('data_idRetorno', id)
execution.setVariable('data_resultadoDiagnostico', resultado)
// Resumo (e não o payload inteiro): variável String do Camunda tem limite de 4000 caracteres.
execution.setVariable('data_resumoDiagnostico', JsonOutput.toJson([
    serviceTestId: execution.getVariable('data_diagnosticoServiceTestId'),
    httpStatus: status,
    state: json instanceof Map ? json.state?.toString() : null,
    resultadoDiagnostico: id ? 'ID' + id : null
]))
</bpmn:script>
    </bpmn:scriptTask>
