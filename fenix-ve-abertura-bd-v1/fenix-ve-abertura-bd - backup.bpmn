    <bpmn:serviceTask id="Node_ConsultaSlots" name="Consulta horários WFM (INT11)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>INT11 WFM Journey POST /searchTimeSlot (exemplo do WFM de 12/11/2026; PreDataMapping v2.2, VIVO1/VIVO2). 200 com slots; 204 = sem slot. Endereço e dados de rede vêm da consulta de asset do VE (wfm*). Pendente: swagger (P09).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_WFM_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">/searchTimeSlot</camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
h['Content-Type'] = 'application/json'
h['flow'] = 'B2B_MASSIVO'
h['requestSystem'] = 'MVE'
h['X-Vivo-Transaction-Id'] = 'TID_ELJY_FTAT933INT005_' + java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())
def cid = execution.getVariable('data_correlationId')
if (cid) { h['X-Vivo-Correlation-Id'] = cid.toString() }
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="bodyTemplate">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
// Estrutura do exemplo WFM de 12/11/2026; origem de postcode, microArea e dados de rede pendente (P08).
def v = { String nome -&gt; def x = execution.getVariable(nome); x == null ? null : x.toString() }
def zona = java.time.ZoneId.of('America/Sao_Paulo')
def hoje = java.time.LocalDate.now(zona)
def iso = java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSSXXX")
def dono = v('data_wfmNetworkOwner') ?: 'VIVO1'
def endereco = [country: 'BR', postcode: v('data_wfmPostcode'), cnl: v('data_wfmCnl'), networkOwner: dono]
if (dono == 'VIVO1') {
    endereco.telephonicArea = v('data_wfmTelephonicArea')
    endereco.centralOffice = v('data_wfmCentralOffice')
    endereco.microArea = v('data_wfmMicroArea')
}
endereco.placePhysicalResourceAssoc = [resourceSpecificationCharacteristic: [[name: 'mediaType', value: v('data_wfmMediaType') ?: 'GPON']]]
endereco.geographicSite = ['@type': 'Cabinet']
if (v('data_wfmGeographicSiteId')) { endereco.geographicSite.id = v('data_wfmGeographicSiteId') }
def atendente = v('data_wfmAttendantId')
def body = [
    relatedEntity: atendente ? [[role: 'Ouvidoria', id: atendente, '@type': 'Attendant']] : [],
    relatedParty: [name: 'TT_B', role: 'acronym'],
    relatedPlace: [geographicAddress: endereco],
    requestedTimeSlot: [[validFor: [
        startDateTime: iso.format(hoje.plusDays(1).atStartOfDay(zona)),
        endDateTime: iso.format(hoje.plusDays(8).atStartOfDay(zona))]]]
]
JsonOutput.toJson(body)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecAgendar_ConsultaSlots</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsultaSlots_TrataSlots</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Node_TrataSlots" name="Interpreta horários" scriptFormat="groovy">
      <bpmn:incoming>Flow_ConsultaSlots_TrataSlots</bpmn:incoming>
      <bpmn:outgoing>Flow_TrataSlots_DecSlots</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def zona = ZoneId.of('America/Sao_Paulo')
def dia = DateTimeFormatter.ofPattern('EEEE, dd/MM/yyyy', new Locale('pt', 'BR'))
def hora = DateTimeFormatter.ofPattern("HH'h'mm")
def status = execution.getVariable('Node_ConsultaSlots-status')
def json = lerJson(execution.getVariable('Node_ConsultaSlots-response'))
def slots = (status == 200 &amp;&amp; json instanceof Map &amp;&amp; json.availableTimeSlot instanceof List) ? json.availableTimeSlot : []
def resumo = []
def itens = []
slots.findAll { it instanceof Map &amp;&amp; it.validFor instanceof Map &amp;&amp; it.validFor.startDateTime }
     .sort { it.validFor.startDateTime.toString() }
     .each { s -&gt;
         if (itens.size() &gt;= 20) { return }
         try {
             def inicio = OffsetDateTime.parse(s.validFor.startDateTime.toString()).atZoneSameInstant(zona)
             def fim = s.validFor.endDateTime ? OffsetDateTime.parse(s.validFor.endDateTime.toString()).atZoneSameInstant(zona) : null
             def valor = itens.size().toString()
             def periodo = fim ? hora.format(inicio) + ' às ' + hora.format(fim) : (s.validFor.timeslot ?: s.id)?.toString()
             resumo &lt;&lt; [value: valor, start: s.validFor.startDateTime.toString(), end: s.validFor.endDateTime?.toString(),
                        timeslot: (s.validFor.timeslot ?: s.id)?.toString(), resourceId: s.resourceId?.toString(),
                        resourceName: s.resourceName?.toString(),
                        data: inicio.format(DateTimeFormatter.ofPattern('dd/MM/yyyy')),
                        periodo: fim ? 'Entre ' + hora.format(inicio) + ' e ' + hora.format(fim) : periodo]
             itens &lt;&lt; [value: valor, label: dia.format(inicio).capitalize() + ' - ' + periodo]
         } catch (Exception ignored) { }
     }
def resultado = 'FALHA'
if (status == 200) {
    resultado = itens ? 'DISPONIVEL' : 'SEM_SLOT'
} else if (status == 204) {
    resultado = 'SEM_SLOT'
}
execution.setVariable('data_resultadoSlots', resultado)
execution.setVariable('data_slotsWfm', JsonOutput.toJson(resumo))
execution.setVariable('data_horariosVisita', JsonOutput.toJson(itens))
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecSlots" name="Há horários disponíveis?" default="Flow_DecSlots_FalhaConsulta">
      <bpmn:incoming>Flow_TrataSlots_DecSlots</bpmn:incoming>
      <bpmn:outgoing>Flow_DecSlots_EscolheHorario</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecSlots_SemHorarios</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecSlots_FalhaConsulta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_SemHorarios" name="Sem horários disponíveis" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecSlots_SemHorarios</bpmn:incoming>
      <bpmn:outgoing>Flow_SemHorarios_End_SemHorarios</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_End_SemHorarios" name="Fim — sem horários">
      <bpmn:incoming>Flow_SemHorarios_End_SemHorarios</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Node_EscolheHorario" name="Escolha do horário" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecSlots_EscolheHorario</bpmn:incoming>
      <bpmn:incoming>Flow_DecHorarioValido_EscolheHorario</bpmn:incoming>
      <bpmn:outgoing>Flow_EscolheHorario_RegistraHorario</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Node_RegistraHorario" name="Registra horário escolhido" scriptFormat="groovy">
      <bpmn:incoming>Flow_EscolheHorario_RegistraHorario</bpmn:incoming>
      <bpmn:outgoing>Flow_RegistraHorario_DecHorarioValido</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def slots = lerJson(execution.getVariable('data_slotsWfm')) ?: []
def escolhido = execution.getVariable('form_horarioVisita')?.toString()
def slot = slots.find { it instanceof Map &amp;&amp; it.value == escolhido }
execution.setVariable('data_horarioValido', slot != null)
if (slot) {
    execution.setVariable('data_slotEscolhido', JsonOutput.toJson(slot))
    execution.setVariable('data_dataVisita', slot.data)
    execution.setVariable('data_woHorario', slot.periodo)
    execution.setVariable('data_visitaInicio', slot.start)
    execution.setVariable('data_visitaFim', slot.end)
    execution.setVariable('data_avisarHorarioMaisCedo', 'true'.equalsIgnoreCase(String.valueOf(execution.getVariable('form_avisarHorarioMaisCedo'))))
    // US-08: a jornada gera o ID da WO usado no fluxo sistêmico.
    execution.setVariable('data_woIdJornada', 'VE' + UUID.randomUUID().toString())
}
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecHorarioValido" name="Horário válido?" default="Flow_DecHorarioValido_EscolheHorario">
      <bpmn:incoming>Flow_RegistraHorario_DecHorarioValido</bpmn:incoming>
      <bpmn:outgoing>Flow_DecHorarioValido_CriaWO</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecHorarioValido_EscolheHorario</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Node_CriaWO" name="Cria WO e agendamento (INT14)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>INT14 WFM Journey POST /workOrder/appointment (PreDataMapping Abertura de WO e agendamento v2.2): WorkOrder_Create + Appointment_Create; 200 devolve idWorkOrder, idWorkOrderItem e idWork. Appointment_Create vem da tela Escolha do horário (form_horarioVisita = slot do WFM, form_avisarHorarioMaisCedo = canBeAntecipated) e dos fixos da aba VE x Camunda. Cliente, endereço e produtos vêm da consulta de asset do VE. Pendente: contato do cliente, pedido (CustomerOrderValue), categoria, coordenadas, DETALHE e referência do endereço (entradas opcionais wo_&lt;campo&gt;).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_WFM_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">/workOrder/appointment</camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
h['Content-Type'] = 'application/json'
h['flow'] = 'B2B_MASSIVO'
h['requestSystem'] = 'MVE'
h['X-Vivo-Transaction-Id'] = 'TID_ELJY_FTAT933INT007_' + java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())
def cid = execution.getVariable('data_correlationId')
if (cid) { h['X-Vivo-Correlation-Id'] = cid.toString() }
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="bodyTemplate">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
// Estrutura do exemplo WFM de 12/11/2026. Dados sem origem definida (P08) vêm de entradas opcionais
// wo_&lt;campo&gt; (data_wo_&lt;campo&gt; no motor) ou ficam nulos; produtos podem vir prontos em wo_relatedEntity (JSON).
def v = { String nome -&gt; def x = execution.getVariable(nome); x == null ? null : x.toString() }
def wo = { String campo -&gt; v('data_wo_' + campo) }
def caracteristica = { String nome, Object valor -&gt; valor == null ? null : ['@type': 'Characteristic', name: nome, value: valor] }
def slot = new JsonSlurper().parseText(v('data_slotEscolhido'))
def woId = v('data_woIdJornada')
def itemId = woId + ':1'
def zona = java.time.ZoneId.of('America/Sao_Paulo')
def dataVisita = java.time.OffsetDateTime.parse(slot.start.toString()).atZoneSameInstant(zona).toLocalDate().toString()
def produtos = wo('relatedEntity') ? new JsonSlurper().parseText(wo('relatedEntity')) : [[
    '@type': 'ProductEntity', id: wo('productId'), name: 'Banda Larga', action: 'Ativo', status: 'Ativo',
    characteristic: [caracteristica('Designator', v('data_designador')),
                     caracteristica('Technology', v('data_wfmMediaType') ?: 'GPON')].findAll { it }]]
if (!wo('relatedEntity') &amp;&amp; wo('acessoId')) {
    produtos &lt;&lt; ['@type': 'ProductEntity', id: wo('acessoId'), name: 'ACESSO', action: 'Ativo', status: 'Ativo',
                 characteristic: [caracteristica('Designator', wo('acessoDesignador'))].findAll { it }]
}
def notas = [[id: 'CRM_NOTES', text: 'Agendamento realizado pelo cliente no fluxo de suporte técnico no Vivo Empresas']]
if (wo('addressReference')) { notas &lt;&lt; [id: 'ADDRESS_REFERENCE', text: wo('addressReference')] }
def body = [
    WorkOrder_Create: [
        '@type': 'WorkOrder',
        sourceSystem: 'MVE',
        id: woId,
        relatedParty: [
            ['@type': 'CustomerValue', category: wo('customerCategory'), documentNumber: wo('documentNumber'),
             id: wo('customerId'), name: wo('customerName'),
             contactMedium: [['@type': 'ContactMediumValue', name: wo('contactName'), characteristic: [[
                 '@type': 'ContactMediumValueCharacteristic', emailAddress: wo('emailAddress'),
                 mobileNumber: wo('mobileNumber'), phoneNumber: wo('phoneNumber'), workNumber: wo('workNumber')]]]]],
            ['@type': 'CustomerOrderValue', dateOfSale: wo('dateOfSale'), id: wo('orderId'), orderProtocol: wo('orderProtocol'),
             characteristic: [caracteristica('Detail', wo('orderDetail'))].findAll { it }],
            ['@type': 'WorkOrderPendency', context: 'TRIAGEM']
        ],
        workOrderItem: [[
            '@type': 'WorkOrderItem',
            id: itemId,
            place: ['@type': 'GeographicAddress', cnl: v('data_wfmCnl'), cnlAcronym: wo('cnlAcronym'), city: wo('city'),
                    neighborhood: wo('neighborhood'), postcode: v('data_wfmPostcode'), stateOrProvince: wo('stateOrProvince'),
                    streetCode: wo('streetCode'), streetName: wo('streetName'), streetNr: wo('streetNr'),
                    networkOwner: v('data_wfmNetworkOwner') ?: 'VIVO1', accessTechnology: v('data_wfmMediaType') ?: 'GPON',
                    centralOffice: v('data_wfmCentralOffice') ?: '', telephonicArea: v('data_wfmTelephonicArea') ?: '',
                    geographicLocation: ['@type': 'GeographicLocation', bbox: [wo('longitude'), wo('latitude')]],
                    geographicSite: ['@type': 'Cabinet', id: v('data_wfmGeographicSiteId')],
                    geographicSubAddress: ['@type': 'GeographicSubAddress', name: wo('complement')]],
            relatedEntity: produtos,
            specification: [acronym: 'TT_B', type: 'TROUBLETICKET', specificationDescription: [
                [name: 'PRODUTO', value: 'Banda'], [name: 'TIPO', value: 'Defeito'],
                [name: 'DETALHE', value: wo('detail')], [name: 'SEQUENCIA', value: '1/1']]]
        ]]
    ],
    Appointment_Create: [
        description: 'Agendamento da atividade',
        category: 'CORPORATE',
        canBeAntecipated: execution.getVariable('data_avisarHorarioMaisCedo') == true,
        externalId: itemId,
        scheduleDate: dataVisita,
        relatedParty: [
            ['@type': 'Attendant', id: v('data_wfmAttendantId') ?: '', role: 'Cliente via Vivo Empresas'],
            ['@type': 'TimeSlot', id: slot.timeslot, resourceId: slot.resourceId, resourceName: slot.resourceName,
             validFor: [startDateTime: slot.start, endDateTime: slot.end]]
        ],
        note: notas
    ]
]
JsonOutput.toJson(body)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecHorarioValido_CriaWO</bpmn:incoming>
      <bpmn:outgoing>Flow_CriaWO_TrataWO</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Node_TrataWO" name="Interpreta criação da WO" scriptFormat="groovy">
      <bpmn:incoming>Flow_CriaWO_TrataWO</bpmn:incoming>
      <bpmn:outgoing>Flow_TrataWO_DecWOCriada</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def status = execution.getVariable('Node_CriaWO-status')
def json = lerJson(execution.getVariable('Node_CriaWO-response'))
def ok = status in [200, 201]
// PreDataMapping v2.2: sucesso = {idWorkOrder, idWorkOrderItem, idWork}; erro = {origin, code, reason, message}.
def corpo = json instanceof Map ? json : [:]
def wo = corpo.idWorkOrder?.toString()
if (ok &amp;&amp; !wo) { wo = execution.getVariable('data_woIdJornada')?.toString() }
execution.setVariable('data_woCriada', ok)
execution.setVariable('data_woNumero', wo)
execution.setVariable('data_woItemId', corpo.idWorkOrderItem?.toString())
execution.setVariable('data_woIdWork', corpo.idWork?.toString())
execution.setVariable('data_woErro', ok ? null : [corpo.code, corpo.reason, corpo.message, corpo.origin].findAll { it }.join(' | ') ?: ('HTTP ' + status))
execution.setVariable('data_tentativasBD', 0)
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecWOCriada" name="WO criada?" default="Flow_DecWOCriada_DecWOIdentificadaFalha">
      <bpmn:incoming>Flow_TrataWO_DecWOCriada</bpmn:incoming>
      <bpmn:outgoing>Flow_DecWOCriada_CriaBD</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecWOCriada_DecWOIdentificadaFalha</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Node_DecWOIdentificadaFalha" name="Há WO para cancelar?" default="Flow_DecWOIdentificadaFalha_AgendamentoNaoRealizado">
      <bpmn:incoming>Flow_DecWOCriada_DecWOIdentificadaFalha</bpmn:incoming>
      <bpmn:outgoing>Flow_DecWOIdentificadaFalha_CancelaWOAgendamento</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecWOIdentificadaFalha_AgendamentoNaoRealizado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Node_CancelaWOAgendamento" name="Cancela WO (INT16)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>US-09: falha no agendamento; só cancela quando há ID da WO. INT16 DELETE /workOrder/{idWorkOrder}?reason=PROBLEMAS SISTEMICOS&amp;context=SISTEMICO (PreDataMapping Cancelamento de WO v1.1; sobrescrevíveis por wo_cancelReason/wo_cancelContext). 200 com body vazio.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">DELETE</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_WFM_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">
            <camunda:script scriptFormat="groovy">'/workOrder/' + java.net.URLEncoder.encode(execution.getVariable('data_woNumero').toString(), 'UTF-8') + '?reason=' + java.net.URLEncoder.encode((execution.getVariable('data_wo_cancelReason') ?: 'PROBLEMAS SISTEMICOS').toString(), 'UTF-8') + '&amp;context=' + java.net.URLEncoder.encode((execution.getVariable('data_wo_cancelContext') ?: 'SISTEMICO').toString(), 'UTF-8')</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
h['Content-Type'] = 'application/json'
h['flow'] = 'B2B_MASSIVO'
h['requestSystem'] = 'MVE'
h['X-Vivo-Transaction-Id'] = 'TID_ELJY_FTAT933INT008_' + java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())
def cid = execution.getVariable('data_correlationId')
if (cid) { h['X-Vivo-Correlation-Id'] = cid.toString() }
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">10000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecWOIdentificadaFalha_CancelaWOAgendamento</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelaWOAgendamento_AgendamentoNaoRealizado</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Node_AgendamentoNaoRealizado" name="Agendamento não realizado" camunda:assignee="${assignee}">
      <bpmn:incoming>Flow_DecWOIdentificadaFalha_AgendamentoNaoRealizado</bpmn:incoming>
      <bpmn:incoming>Flow_CancelaWOAgendamento_AgendamentoNaoRealizado</bpmn:incoming>
      <bpmn:outgoing>Flow_AgendamentoNaoRealizado_End_AgendamentoNaoRealizado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_End_AgendamentoNaoRealizado" name="Fim — visita não agendada">
      <bpmn:incoming>Flow_AgendamentoNaoRealizado_End_AgendamentoNaoRealizado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Node_CriaBD" name="Abre BD (INT18)" camunda:delegateExpression="${httpTask}">
      <bpmn:documentation>INT18 Trouble Ticket Management v1 POST /troubleTicket (PreDataMapping Abertura BD v2.1); o MS orquestra TMF629/TMF621. Número do BD = externalIdentifier.id.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="baseUrl">${environment.getProperty('FENIX_VE_TT_BASE_URL')}</camunda:inputParameter>
          <camunda:inputParameter name="path">/troubleTicket</camunda:inputParameter>
          <camunda:inputParameter name="headers">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
def h = ['Accept': 'application/json']
h['Content-Type'] = 'application/json'
h['X-Vivo-Transaction-Id'] = 'TID_ELJY_FTAT933INT009_' + java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())
def cid = execution.getVariable('data_correlationId')
if (cid) { h['X-Vivo-Correlation-Id'] = cid.toString() }
def auth = execution.getVariable('_authorizationHeader')
if (auth) { h['Authorization'] = auth.toString() }
JsonOutput.toJson(h)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="bodyTemplate">
            <camunda:script scriptFormat="groovy">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
// Campos sem origem confirmada vêm de variáveis opcionais enviadas no início: bd_&lt;campo&gt; (data_bd_&lt;campo&gt; no motor).
def v = { String nome -&gt; def x = execution.getVariable(nome); x == null ? null : x.toString() }
def bd = { String campo -&gt; v('data_bd_' + campo) }
def slot = new JsonSlurper().parseText(v('data_slotEscolhido'))
def carac = new LinkedHashMap()
['estadoDescricao', 'city', 'endBairro', 'postcode', 'telephonicArea', 'streetName', 'streetNr', 'complement',
 'reclamanteNome', 'documentNumber', 'clienteClassificacao', 'contatoLocal', 'telefoneContatoLocal1',
 'telefoneContatoLocal2', 'motivo', 'submotivo', 'SLA', 'tipoDescricao', 'tipoOferta', 'designadorAcesso',
 'velocidade', 'servicoCpccNome', 'WorkOrder', 'WorkOrderItem', 'etapa', 'telefoneTitular1', 'telefoneTitular2',
 'telefoneReclamante1', 'telefoneReclamante2', 'horarioFuncionamento', 'preferenciaContato', 'palitagemFinal',
 'previsaoAtendimento', 'caseOrigin', 'payloadDiagnostico', 'idAppointment'].each { carac[it] = bd(it) }
carac.designadorAcesso = v('data_designador')
carac.WorkOrder = v('data_woNumero') ?: v('data_woIdJornada')
carac.WorkOrderItem = v('data_woItemId') ?: carac.WorkOrderItem
carac.previsaoAtendimento = slot.data + ' ' + slot.timeslot
carac.payloadDiagnostico = v('data_resumoDiagnostico') ?: carac.payloadDiagnostico
carac.etapa = carac.etapa ?: 'TRIAGEM'
def relatedEntity = []
[['Product', 'ServiceTest', 'ProductInventory', bd('productInventoryId')],
 ['Service', 'ServiceTest', 'testSpecification', v('data_hpsdTestSpecificationId')],
 ['Service', 'Service', 'relatedServiceSpecification', bd('relatedServiceSpecificationId')],
 ['Service', 'Service', 'relatedService', bd('relatedServiceId')],
 ['Service', 'Service', 'mode', 'Proactive']].each { item -&gt;
    if (item[3]) { relatedEntity &lt;&lt; ['@type': item[0], entity: ['@type': item[1], name: item[2], id: item[3]]] }
}
def relatedParty = []
if (bd('customerId')) {
    relatedParty &lt;&lt; ['@type': 'Customer', role: 'Digital', partyOrPartyRole: [
        '@type': 'Customer', id: bd('customerId'), name: bd('customerName'), '@referredType': 'CustomerContact',
        characteristic: [['EmailContactMedium', bd('email')], ['PhoneContactMedium', bd('phone')], ['idCustomer', bd('serviceNowCustomerId')]]
            .findAll { it[1] }.collect { [name: it[0], value: it[1]] }]]
}
def body = [
    '@type': 'ServiceProblemCase',
    ticketType: 'Case',
    description: bd('description') ?: 'Abertura de BD pelo VE (FTAT-933): diagnóstico automático não resolveu o problema',
    severity: bd('severity') ?: '3',
    name: bd('name') ?: 'Queda de Conexão',
    requestedResolutionDate: slot.start,
    expectedResolutionDate: slot.end,
    channel: [name: bd('channel') ?: 'Alert'],
    relatedEntity: relatedEntity,
    relatedParty: relatedParty,
    troubleTicketCharacteristic: carac.findAll { it.value != null }.collect { [name: it.key, value: it.value] }
].findAll { it.value != null }
JsonOutput.toJson(body)</camunda:script>
          </camunda:inputParameter>
          <camunda:inputParameter name="connectTimeoutMs">3000</camunda:inputParameter>
          <camunda:inputParameter name="responseTimeoutMs">20000</camunda:inputParameter>
          <camunda:inputParameter name="maxAttempts">1</camunda:inputParameter>
          <camunda:inputParameter name="sendToken">${false}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DecWOCriada_CriaBD</bpmn:incoming>
      <bpmn:incoming>Flow_DecRetentarBD_CriaBD</bpmn:incoming>
      <bpmn:outgoing>Flow_CriaBD_TrataBDCriado</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Node_TrataBDCriado" name="Interpreta abertura do BD" scriptFormat="groovy">
      <bpmn:incoming>Flow_CriaBD_TrataBDCriado</bpmn:incoming>
      <bpmn:outgoing>Flow_TrataBDCriado_DecBDCriado</bpmn:outgoing>
      <bpmn:script>import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.*
import java.time.format.DateTimeFormatter

def lerJson(Object texto) {
    if (texto == null || texto.toString().trim().isEmpty()) { return null }
    try { return new JsonSlurper().parseText(texto.toString()) } catch (Exception e) { return null }
}

def status = execution.getVariable('Node_CriaBD-status')
def json = lerJson(execution.getVariable('Node_CriaBD-response'))
def tentativas = ((execution.getVariable('data_tentativasBD') ?: 0) as Integer) + 1
def ok = status in [200, 201]
execution.setVariable('data_tentativasBD', tentativas)
execution.setVariable('data_bdCriado', ok)
if (ok &amp;&amp; json instanceof Map) {
    execution.setVariable('data_bdCriadoId', json.id?.toString())
    execution.setVariable('data_bdCriadoNumero', (json.externalIdentifier instanceof Map ? json.externalIdentifier.id : null)?.toString())
}
if (ok) {
    // A tela de sucesso lê form.dataVisita; a resposta original some no próximo /advance (retentativas).
    execution.setVariable('form_dataVisita', execution.getVariable('data_dataVisita'))
}
</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Node_DecBDCriado" name="BD criado?" default="Flow_DecBDCriado_DecWOIdentificadaBD">
