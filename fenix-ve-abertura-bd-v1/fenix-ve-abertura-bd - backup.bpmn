      <bpmn:outgoing>Flow_DecBDCriado_VisitaAgendada</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecBDCriado_RetentarBD</bpmn:outgoing>
      <bpmn:outgoing>Flow_DecBDCriado_DecWOIdentificadaBD</bpmn:outgoing>
    </bpmn:exclusiveGateway>
